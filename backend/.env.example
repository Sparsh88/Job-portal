# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

DATABASE_URL="postgresql://username:password@hostname:port/database?sslmode=require"

# JWT Authentication Secrets
JWT_ACCESS_SECRET=hirehub_super_secret_access_token_key_2026
JWT_REFRESH_SECRET=hirehub_super_secret_refresh_token_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Integration (File & Resume Storage)
CLOUDINARY_CLOUD_NAME=hirehub_demo
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz123456

# Nodemailer / SMTP Email Service
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=demo_user
SMTP_PASS=demo_password
SMTP_FROM="HireHub AI <no-reply@hirehub.ai>"

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_HireHubDemoKey123
RAZORPAY_KEY_SECRET=HireHubDemoSecretKey456
